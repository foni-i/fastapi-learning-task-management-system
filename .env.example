# Copy this file to .env for local development. Never commit real secrets.
# Application behavior. Health/live and OpenAPI do not require PostgreSQL.
STMS_ENV=development
STMS_DEBUG=true
STMS_API_DOCS_ENABLED=true
# Local uv/Alembic database URL. Compose overrides the app container URL internally.
# Example credentials only; replace locally and never use them in production.
STMS_DATABASE_URL=postgresql+psycopg://stms_dev:stms_dev_local@127.0.0.1:5432/stms

# Required only for login/token-protected APIs. Replace the secret locally.
STMS_ACCESS_TOKEN_SECRET=replace-with-random-secret-at-least-32-characters
STMS_ACCESS_TOKEN_TTL_MINUTES=15
STMS_ACCESS_TOKEN_ISSUER=fastapi-stms
STMS_ACCESS_TOKEN_AUDIENCE=fastapi-stms-api

# Required only for real Agent planning or explicit document indexing.
# Ordinary tests and offline evaluation use deterministic fakes and need no API key.
# These placeholders do not enable model calls.
STMS_MODEL_PROVIDER=openai
STMS_MODEL_NAME=replace-with-supported-model-id
STMS_EMBEDDING_MODEL=replace-with-1536-dimension-embedding-model-id
STMS_EMBEDDING_TIMEOUT_SECONDS=30
STMS_MODEL_API_KEY=replace-with-provider-api-key

# Docker Compose-only interpolation. Development and test credentials are distinct.
# `docker compose up -d --build --wait app` exposes the app on this host port.
STMS_APP_PORT=8000
STMS_POSTGRES_DEV_DB=stms
STMS_POSTGRES_DEV_USER=stms_dev
STMS_POSTGRES_DEV_PASSWORD=stms_dev_local
STMS_POSTGRES_DEV_PORT=5432
STMS_POSTGRES_TEST_DB=stms_test
STMS_POSTGRES_TEST_USER=stms_test
STMS_POSTGRES_TEST_PASSWORD=stms_test_local
STMS_POSTGRES_TEST_PORT=5433

# Explicit opt-in URL used only by pytest integration tests. It must target the
# dedicated postgres-test service; never point it at the development database.
STMS_TEST_DATABASE_URL=postgresql+psycopg://stms_test:stms_test_local@127.0.0.1:5433/stms_test
